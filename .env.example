# 本機開發設定。複製成 .env 後填入；.env 只放在本機，不會被 commit。
# Server（pnpm dev）與 Runner（pnpm dev:runner）都從 repo 根目錄的 .env 讀取。

# ── Server ────────────────────────────────────────────────
# docker compose up 啟動的 Postgres
ORBIS_DATABASE_URL=postgres://orbis:orbis@localhost:5432/orbis

# GitHub OAuth App（callback URL 設為 http://localhost:5173/api/auth/github/callback）
ORBIS_GITHUB_CLIENT_ID=
ORBIS_GITHUB_CLIENT_SECRET=

# 第一次登入時建立 Team 並成為 Owner 的 GitHub「數字 user id」（不是 login；login 可以改名）。
# 查詢方式：gh api user --jq .id。只在還沒有任何 Team 時生效。
ORBIS_BOOTSTRAP_OWNER=

# Server 的 HTTP 與 WebSocket port（不是 ORBIS_PORT：那是注入 Worktree 的 Preview port）
ORBIS_SERVER_PORT=4000
# Web 的 origin，OAuth 完成後導回這裡；GitHub Issue 中的 Task 連結也以它為準（<PUBLIC_URL>/tasks/<Task Key>）
ORBIS_PUBLIC_URL=http://localhost:5173
# Server 的公開網址，/api/health 回傳給 Desktop，Runner 連 <API_ORIGIN>/runner。
# 未設定時為 http://localhost:<ORBIS_SERVER_PORT>
ORBIS_API_ORIGIN=
# blob（大型 Event 內容、review diff 的大檔案、截圖）的存放目錄。未設定時為 apps/server/data/blobs
ORBIS_BLOB_DIR=

# 開發用的 Pairing token stub：Runner 送出相同的值就能以 Team Runner 完成 Pairing（只供 pnpm dev:runner）。
# 正式流程由 Web／Desktop 呼叫 /api/runner-pairing-tokens 產生一次性的 token
ORBIS_DEV_PAIRING_TOKEN=dev-pairing-token
# HelloAck 告訴 Runner 的 Heartbeat 間隔（毫秒，最小 1000）
ORBIS_RUNNER_HEARTBEAT_INTERVAL_MS=15000

# GitHub App（Issues 雙向同步、開 PR、Repo 的 App 安裝狀態）。四個都不填時 GitHub 整合停用；
# 只填一部分 Server 會拒絕啟動。建立方式見 packages/github/README.md（pnpm --filter @orbis/github app:create）。
# App ID（數字）
ORBIS_GITHUB_APP_ID=
# App 的 private key（PEM）；在 .env 中可以用 \n 表示換行
ORBIS_GITHUB_APP_PRIVATE_KEY=
# webhook secret（驗證 X-Hub-Signature-256）；webhook 網址是 <Server 對外網址>/api/webhooks/github
ORBIS_GITHUB_WEBHOOK_SECRET=
# App 的 slug（https://github.com/apps/<slug>），用來組安裝連結、辨認 App 自己的 bot 帳號
ORBIS_GITHUB_APP_SLUG=

# fatal、error、warn、info、debug、trace、silent
ORBIS_LOG_LEVEL=info

# ── Runner（pnpm dev:runner）──────────────────────────────
ORBIS_SERVER_URL=http://localhost:4000
ORBIS_PAIRING_TOKEN=dev-pairing-token
# Runner 的 log 過濾條件（tracing EnvFilter 語法）
ORBIS_LOG=info
