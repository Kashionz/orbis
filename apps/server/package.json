{
  "name": "@orbis/server",
  "version": "0.1.0",
  "private": true,
  "description": "Orbis Server：Hono API、Runner WebSocket、Drizzle（B 軌）",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "tsx scripts/db-check.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@orbis/api-contract": "workspace:*",
    "@orbis/protocol": "workspace:*",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "uuid": "14.0.3",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
