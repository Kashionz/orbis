# Orbis 正式部署的設定（docs/INSTALL.md）。複製成 deploy/.env 後填入；deploy/.env 不會被 commit。
# compose 以這個檔案做變數代換，Server 容器也直接讀它（env_file）。變數名稱見 apps/server/src/config.ts。

# ── compose 本身的設定（不會傳進 Server）────────────────────────────────────
# Postgres 的帳號（只在 compose 網路內可以連到）。密碼必填，請自行產生一組亂數。
ORBIS_DB_USER=orbis
ORBIS_DB_PASSWORD=
ORBIS_DB_NAME=orbis
# Server 對外的位址與 port。預設只綁 127.0.0.1，由同一台機器上的反向代理提供 HTTPS；
# 要讓區域網路（例如 Windows Sandbox／VM）直接連時改成 0.0.0.0。
ORBIS_DEPLOY_BIND=127.0.0.1
ORBIS_DEPLOY_PORT=4000
# compose project 名稱（容器與 volume 的前綴）。同一台機器要跑第二套時改掉。
ORBIS_DEPLOY_PROJECT=orbis

# ── Server ────────────────────────────────────────────────────────────────
# 使用者在瀏覽器打開的網址（也是 OAuth 的 redirect 與 Issue 中 Task 連結的 base）。
# 有反向代理時填 https://orbis.example.com；沒有時填 http://<主機 IP>:4000。
ORBIS_PUBLIC_URL=
# Runner 連的網址（/api/health 回給 Desktop）。Web 與 API 在同一個 origin，留空等於 ORBIS_PUBLIC_URL。
ORBIS_API_ORIGIN=

# GitHub OAuth App（登入用）。callback URL 要設成 <ORBIS_PUBLIC_URL>/api/auth/github/callback
ORBIS_GITHUB_CLIENT_ID=
ORBIS_GITHUB_CLIENT_SECRET=

# 第一次登入時建立 Team 並成為 Owner 的 GitHub「數字 user id」（不是 login）。
# 查詢方式：gh api user --jq .id，或 https://api.github.com/users/<login> 的 id。只在還沒有任何 Team 時生效。
ORBIS_BOOTSTRAP_OWNER=

# GitHub App（Issues 雙向同步、開 PR、Feedback Loop）。四個都不填時 GitHub 整合停用；只填一部分 Server 拒絕啟動。
ORBIS_GITHUB_APP_ID=
# private key（PEM）。整段放在一行、換行用 \n 表示：
# ORBIS_GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n"
ORBIS_GITHUB_APP_PRIVATE_KEY=
# webhook secret；webhook 網址是 <ORBIS_PUBLIC_URL>/api/webhooks/github
ORBIS_GITHUB_WEBHOOK_SECRET=
# App 的 slug（https://github.com/apps/<slug>）
ORBIS_GITHUB_APP_SLUG=

# Preview 網域（選填，ARCHITECTURE §13）：Run 的 Preview 網址是 <run-id>.<這個網域>，需要 wildcard DNS 與
# wildcard 憑證，反向代理要把 *.<網域> 也轉給 Server。留空時只能在執行 Run 的電腦上用 Desktop 開 Preview。
ORBIS_PREVIEW_DOMAIN=

# fatal、error、warn、info、debug、trace、silent
ORBIS_LOG_LEVEL=info
# Runner 的 Heartbeat 間隔（毫秒）
ORBIS_RUNNER_HEARTBEAT_INTERVAL_MS=15000

# ── Team Runner（compose profile `team-runner`）─────────────────────────────
# 在 UI 上顯示的名稱
ORBIS_TEAM_RUNNER_NAME=team-runner
# Runner 連 Server 的網址。預設走 compose 網路（http://server:4000）；Server 在別台機器時填它的公開網址。
ORBIS_TEAM_RUNNER_SERVER_URL=
# Runner 的 log 過濾條件（tracing EnvFilter 語法）
ORBIS_TEAM_RUNNER_LOG=info
# Runner 自動 commit 時的作者
ORBIS_TEAM_RUNNER_GIT_USER_NAME=Orbis Team Runner
ORBIS_TEAM_RUNNER_GIT_USER_EMAIL=orbis-team-runner@localhost
