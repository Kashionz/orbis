# 預設所有文字檔在 repo 與工作目錄都用 LF，不受各人的 core.autocrlf 影響
* text=auto eol=lf

# cmd 與 PowerShell 腳本在 Windows 上需要 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二進位檔
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.gz binary
*.exe binary
*.dll binary
*.node binary
